# Root .env - keys read by src/services/external_search.py via load_dotenv().
# Copy to .env and fill in. See docs/PORTING.md ("How .env is actually consumed").
#
# LITCORE_* settings (database/PDF/vector-store paths, Zotero, log level,
# embedding device) are documented in src/.env.example and are read from a
# .env in the working directory (src/) or from exported environment variables.

# External literature APIs (Semantic Scholar, Unpaywall, Crossref, OpenAlex, PubMed, Springer)
SEMANTIC_SCHOLAR_API_KEY=
UNPAYWALL_EMAIL=you@example.edu
CROSSREF_MAILTO=you@example.edu
OPENALEX_EMAIL=you@example.edu
PUBMED_EMAIL=you@example.edu
PUBMED_TOOL=literature-ai
SPRINGER_API_KEY=
SPRINGER_OPENACCESS_API_KEY=
ENABLE_ARXIV=true

# Windows-browser PDF fetch queue (mcp_server/tools/browser_pdf.py); only on WSL2
# WINDOWS_USER=your_windows_username
