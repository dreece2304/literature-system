# Literature Core Configuration
# Copy this file to .env and fill in your values
# All variables are prefixed with LITCORE_

# =============================================================================
# Database Paths (all paths can be absolute or relative to working directory)
# =============================================================================

# SQLite database path
# Default: infrastructure/literature-database/data/metadata/literature.db
# LITCORE_DATABASE_PATH=/path/to/literature.db

# ChromaDB vector store path (for semantic search)
# Default: infrastructure/literature-database/data/chroma
# LITCORE_CHROMA_PATH=/path/to/chroma

# PDF storage path
# Default: infrastructure/literature-database/data/pdfs
# LITCORE_PDF_STORAGE_PATH=/path/to/pdfs

# Whoosh search index path
# Default: infrastructure/literature-database/data/whoosh
# LITCORE_SEARCH_INDEX_PATH=/path/to/whoosh

# =============================================================================
# Zotero Integration
# =============================================================================

# Zotero API key (get from https://www.zotero.org/settings/keys)
# LITCORE_ZOTERO_API_KEY=your_api_key_here

# Zotero library ID (user ID or group ID)
# LITCORE_ZOTERO_LIBRARY_ID=1234567

# Library type: "user" or "group"
# Default: user
# LITCORE_ZOTERO_LIBRARY_TYPE=user

# =============================================================================
# External API Keys
# =============================================================================

# Semantic Scholar API key (for higher rate limits)
# Get from: https://www.semanticscholar.org/product/api
# LITCORE_SEMANTIC_SCHOLAR_API_KEY=your_api_key_here

# OpenAI API key (for embeddings if using OpenAI models)
# LITCORE_OPENAI_API_KEY=sk-your_key_here

# =============================================================================
# Logging
# =============================================================================

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
# Default: INFO
# LITCORE_LOG_LEVEL=INFO

# Log file path (optional, logs to stdout by default)
# LITCORE_LOG_FILE=/path/to/literature.log
