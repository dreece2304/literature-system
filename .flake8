[flake8]
max-line-length = 120
exclude =
    src/alembic/versions/*
    src/scripts/*
per-file-ignores =
    src/mcp_server/*.py:E402
    src/mcp_server/**/*.py:E402,E501
    src/services/extraction_service.py:E402,E501
    src/services/extraction_prompts.py:E501,W291,W293
    src/alembic/env.py:E402
