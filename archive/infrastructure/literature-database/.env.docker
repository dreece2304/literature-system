# Docker Environment Variables
# Copy this file to .env and modify as needed

# Database Configuration
POSTGRES_PASSWORD=secure_literature_password_change_this
REDIS_PASSWORD=secure_redis_password_change_this

# Service Configuration
SERVICE_NAME=literature-database
SERVICE_PORT=8001
SERVICE_HOST=0.0.0.0

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/litdb.log

# Development vs Production
DEBUG=false
RELOAD=false

# CORS Origins (comma-separated for development)
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000", "http://localhost:8080"]

# Zotero Configuration (adjust for your setup)
ZOTERO_WINDOWS_PATH=/mnt/c/Users/dreec/Zotero
ZOTERO_LIBRARY_TYPE=user

# Redis Configuration
REDIS_ENABLED=true