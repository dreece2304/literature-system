# Literature AI Service Configuration
# Copy this file to .env and update with your settings

# ============================================================================
# ENVIRONMENT
# ============================================================================
ENVIRONMENT=development
DEBUG=true

# ============================================================================
# OLLAMA CONFIGURATION
# ============================================================================
OLLAMA_HOST=http://localhost:11434
OLLAMA_TIMEOUT=120
OLLAMA_KEEP_ALIVE=60

# Model selection
OLLAMA_WRITER_MODEL=qwen:7b-q5_K_M
OLLAMA_TRIAGER_MODEL=qwen:7b-q4_K_M
OLLAMA_READER_MODEL=qwen:7b-q5_K_M

# Temperature settings (0.0 = deterministic, 2.0 = creative)
OLLAMA_WRITER_TEMPERATURE=0.7
OLLAMA_TRIAGER_TEMPERATURE=0.3
OLLAMA_READER_TEMPERATURE=0.1

OLLAMA_MAX_CONTEXT_LENGTH=8192

# ============================================================================
# EMBEDDING CONFIGURATION
# ============================================================================
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
EMBEDDING_BATCH_SIZE=32
EMBEDDING_DEVICE=cuda
EMBEDDING_NORMALIZE=true

# Text chunking
EMBEDDING_CHUNK_SIZE=512
EMBEDDING_CHUNK_OVERLAP=128

# ============================================================================
# CHROMADB VECTOR STORE
# ============================================================================
# CHROMA_PERSIST_DIRECTORY=./data/vectorstore  # Uses default if not set
CHROMA_COLLECTION_NAME=papers
CHROMA_DISTANCE_METRIC=cosine
CHROMA_TOP_K=10
CHROMA_SCORE_THRESHOLD=0.7

# ============================================================================
# REDIS CONFIGURATION (Optional - for background tasks)
# ============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=  # Uncomment if Redis requires authentication

# Event channels
REDIS_PAPER_EVENTS_CHANNEL=paper.events

# Caching
REDIS_CACHE_TTL=3600
REDIS_CACHE_ENABLED=true

# ============================================================================
# CELERY TASK QUEUE (Optional - for background tasks)
# ============================================================================
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json
CELERY_TIMEZONE=UTC
CELERY_ENABLE_UTC=true

# Worker settings
CELERY_WORKER_PREFETCH_MULTIPLIER=1
CELERY_WORKER_MAX_TASKS_PER_CHILD=100

# ============================================================================
# LITERATURE DATABASE
# ============================================================================
# NOTE: The MCP server accesses the database directly via services.
# No HTTP API is needed - the api_url is deprecated.
#
# LITDB_DATABASE_PATH=./data/literature.db  # Uses default if not set
LITDB_TIMEOUT=30

# ============================================================================
# MCP SERVER (Replaces FastAPI)
# ============================================================================
# The MCP server communicates via stdio, not HTTP.
# Claude Code starts it automatically based on claude.json configuration.
#
MCP_SERVICE_NAME=literature
MCP_VERSION=0.1.0
MCP_LOG_LEVEL=INFO

# ============================================================================
# LOGGING
# ============================================================================
LOG_LEVEL=INFO
# LOG_FILE=./logs/literature-ai.log  # Uses default if not set
LOG_ROTATION=100 MB
LOG_RETENTION=30 days
LOG_COMPRESSION=zip
LOG_JSON_LOGS=false

# ============================================================================
# GPU SETTINGS
# ============================================================================
GPU_ENABLE_MONITORING=true
GPU_MAX_VRAM_USAGE=7.5
GPU_MEMORY_THRESHOLD=0.9
GPU_UNLOAD_DELAY=60
GPU_FORCE_SERIALIZE=true

# ============================================================================
# EXTERNAL API KEYS (Optional)
# ============================================================================
# Semantic Scholar API (for citation counts)
# SEMANTIC_SCHOLAR_API_KEY=your_key_here

# Unpaywall (for open access PDF URLs)
# UNPAYWALL_EMAIL=your@email.com

# Zotero sync
# ZOTERO_API_KEY=your_key_here
# ZOTERO_USER_ID=your_user_id

# Anthropic (for AI extraction with Claude)
# ANTHROPIC_API_KEY=your_key_here

# ============================================================================
# DEVELOPMENT / TESTING
# ============================================================================
# Uncomment for testing
# ENVIRONMENT=testing
# EMBEDDING_DEVICE=cpu
# REDIS_DB=1
