# Docker ignore file for literature-database service
# Excludes unnecessary files from Docker build context

# Python cache and compiled files
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
.env/
.venv/
ENV/
env/
venv/

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Git files
.git/
.gitignore
.gitattributes

# Documentation (included in image but not needed for build)
*.md
docs/
*.rst

# Test files (exclude from production builds)
tests/
test_*.py
*_test.py
pytest.ini
.pytest_cache/
.coverage
htmlcov/
.tox/

# Jupyter notebooks
.ipynb_checkpoints/
*.ipynb

# Log files
logs/
*.log

# Database files (will be mounted)
data/metadata/*.db
data/metadata/*.db-*

# PDF files (will be mounted)
data/pdfs/
*.pdf

# Search index cache (will be rebuilt)
data/cache/

# Temporary files
tmp/
temp/
.tmp/
*.tmp

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Docker files (don't include in image)
Dockerfile
docker-compose*.yml
.dockerignore

# CI/CD files
.github/
.gitlab-ci.yml
.travis.yml
Jenkinsfile

# Environment-specific files
.env.local
.env.development
.env.test
.env.production
.env.*.local

# Package manager files
package-lock.json
yarn.lock
Pipfile.lock

# Backup files
*.backup
*.bak
*.old

# Coverage reports
coverage.xml
*.cover
.hypothesis/

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# Development scripts
scripts/test_*.py
scripts/dev_*.py
scripts/debug_*.py

# Large data files that should be mounted
*.csv
*.json
*.xlsx
*.zip
*.tar.gz

# Conda environment files
environment.yml
environment.yaml